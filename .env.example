NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local dev only (server): fallback tenant when logged in without JWT salon_slug. Never rely on this in production.
DEV_SALON_SLUG=
# Legacy dev fallback (avoid in new setups); prefer DEV_SALON_SLUG (server-only).
NEXT_PUBLIC_DEV_SALON_SLUG=

RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe tenant fallback toggle (temporary migration path).
# true (default): allow owner_email fallback when customer/subscription id is missing.
# false: disable owner_email fallback and resolve tenants only by Stripe ids.
STRIPE_ALLOW_OWNER_EMAIL_FALLBACK=true
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_COLLECTIVE=
STRIPE_PRICE_SMS_ADDON=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Лендинг: месечни суми (MASTER: 19 / 29 / 49 / 49 €). Празно → „По договаряне“.
NEXT_PUBLIC_PLAN_PRICE_STANDARD=19
NEXT_PUBLIC_PLAN_PRICE_PRO=29
NEXT_PUBLIC_PLAN_PRICE_PREMIUM=49
NEXT_PUBLIC_PLAN_PRICE_COLLECTIVE=49
NEXT_PUBLIC_PLAN_PRICE_CURRENCY=€

# Optional: Stripe Payment Links (публични URL към checkout) — когато са зададени, бутон „Плати онлайн“ на landing и на /get-started сочи към тях.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_STANDARD=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PREMIUM=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_COLLECTIVE=

INFOBIP_API_KEY=
INFOBIP_BASE_URL=

NEXT_PUBLIC_APP_URL=https://salonapp.pro
NEXT_PUBLIC_APP_DOMAIN=salonapp.pro
CRON_SECRET=

# Задължителен за super-admin impersonation (fail-closed без него) — 32+ произволни байта
IMPERSONATION_HMAC_SECRET=

# Meta (Facebook) Pixel + Conversions API — само за маркетинг сайта salonapp.pro
# Pixel/Dataset ID — публичен (браузър пиксел + CAPI сървър ползват същия).
NEXT_PUBLIC_META_PIXEL_ID=
# CAPI access token — ТАЕН (server-only). Events Manager → Settings → Conversions API → Generate.
META_CAPI_ACCESS_TOKEN=
# По избор: test event code за проверка в Events Manager → Test Events (махни го в production).
META_CAPI_TEST_EVENT_CODE=

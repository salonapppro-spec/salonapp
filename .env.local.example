# Копирай като `.env.local` (не се комитира). Стойности от MASTER — SalonApp.pro

# Supabase (EU)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Опционално: Postgres URI за еднократни node скрипти (npm run db:apply-019) — паролата е от Supabase → Database, не service_role
# DATABASE_URL=

# Локален dev: fallback salon_slug за админ без metadata в JWT (само development)
DEV_SALON_SLUG=
NEXT_PUBLIC_DEV_SALON_SLUG=

# Имейл
RESEND_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe tenant fallback toggle (temporary migration path).
# true (default): allow owner_email fallback when customer/subscription id is missing.
# false: disable owner_email fallback and resolve tenants only by Stripe ids.
STRIPE_ALLOW_OWNER_EMAIL_FALLBACK=true
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_COLLECTIVE=
STRIPE_PRICE_SMS_ADDON=

# Twilio (SMS/Viber — Премиум / Колектив)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Приложение
NEXT_PUBLIC_APP_URL=https://salonapp.pro
NEXT_PUBLIC_APP_DOMAIN=salonapp.pro
CRON_SECRET=

# Публични цени на лендинга (по желание — ако липсват, се ползват 19 / 29 / 49 / 49 € от MASTER)
NEXT_PUBLIC_PLAN_PRICE_STANDARD=
NEXT_PUBLIC_PLAN_PRICE_PRO=
NEXT_PUBLIC_PLAN_PRICE_PREMIUM=
NEXT_PUBLIC_PLAN_PRICE_COLLECTIVE=
NEXT_PUBLIC_PLAN_PRICE_CURRENCY=€

# Stripe Payment Links (опционално)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_STANDARD=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PREMIUM=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_COLLECTIVE=
